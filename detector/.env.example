# Copy to detector/.env and fill in values from `sam deploy` outputs.
API_ENDPOINT=https://YOUR_API_ID.execute-api.us-east-1.amazonaws.com/prod/track
API_KEY=
CAMERA_INDEX=0
CONFIDENCE=0.3
DEBOUNCE_SECONDS=20
NEIGHBOR_PIXELS=150
MODEL_PATH=yolov8s-worldv2.pt
TRACKED_OBJECTS=wallet,keys,charger,phone,remote,glasses,headphones
LANDMARKS=couch,chair,table,lamp,tv,laptop,bottle,backpack
